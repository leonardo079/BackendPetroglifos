# === Gemini API ===
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MODEL_LITE=gemini-1.5-flash-8b
EMBEDDING_MODEL=text-embedding-004

# === PostgreSQL + pgvector ===
DATABASE_URL=postgresql+asyncpg://petro:petro@localhost:5432/petroglifos
DATABASE_URL_SYNC=postgresql+psycopg2://petro:petro@localhost:5432/petroglifos

# === RAG ===
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.55
CONFIDENCE_THRESHOLD=0.70

# === Object Storage (Cloudflare R2 / MinIO) ===
STORAGE_BUCKET=petroglifos
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# === Redis / Celery ===
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# === GAN API externa ===
GAN_API_URL=http://localhost:8001/reconstruct
GAN_API_KEY=
GAN_MOCK_MODE=true

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# === App ===
ENV=development
LOG_LEVEL=INFO
MAX_RECORD_SHEET_MINUTES=45
