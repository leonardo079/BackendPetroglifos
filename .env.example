# === Gemini API ===
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MODEL_LITE=gemini-1.5-flash
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_MODEL=text-embedding-004

# === PostgreSQL + pgvector ===
DATABASE_URL=postgresql+asyncpg://petro:petro@localhost:5432/petroglifos
DATABASE_URL_SYNC=postgresql+psycopg2://petro:petro@localhost:5432/petroglifos

# === RAG ===
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.55
CONFIDENCE_THRESHOLD=0.70
RAG_INGEST_ENABLED=false

# === Cloudinary ===
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_IMAGE_FOLDER=petroglifos/uploads
CLOUDINARY_PDF_FOLDER=petroglifos/fichas

# === Redis / Celery ===
REDIS_URL=redis://default:your_password@your_host:your_port/0

# === GAN API externa ===
RECONSTRUCTION_API_BASE_URL=http://localhost:8001
RECONSTRUCTION_VISUAL_ASSISTED_URL=http://localhost:8001/reconstructVisualAssisted
GAN_API_URL=http://localhost:8001/reconstruct
GAN_API_KEY=
GAN_MOCK_MODE=true
# Fracción de la figura dañada (0.0-1.0) que fuerza reconstrucción automática en A5
DAMAGE_RECONSTRUCTION_THRESHOLD=0.70

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# === App ===
ENV=development
LOG_LEVEL=INFO
MAX_RECORD_SHEET_MINUTES=45
